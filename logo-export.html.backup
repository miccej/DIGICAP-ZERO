<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DIGICAP Logo Export</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background: #000; }
        .logo-container {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
        }
        .subtitle-letter {
            font-size: 18px;
            font-weight: 900;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-10">
    <div class="bg-black p-20 rounded-xl shadow-2xl border border-slate-800">
        <div class="logo-container">
            <h1 class="text-[120px] font-black tracking-tighter text-[#f59e0b] leading-none flex items-start">
                DIGICAP
                <span class="text-[32px] font-bold text-slate-500 ml-2 mt-4 align-top select-none">®</span>
            </h1>
            <div class="w-full flex justify-between mt-[-15px] px-1">
                <span class="subtitle-letter">C</span>
                <span class="subtitle-letter">A</span>
                <span class="subtitle-letter">P</span>
                <span class="subtitle-letter">A</span>
                <span class="subtitle-letter">B</span>
                <span class="subtitle-letter">I</span>
                <span class="subtitle-letter">L</span>
                <span class="subtitle-letter">I</span>
                <span class="subtitle-letter">T</span>
                <span class="subtitle-letter">Y</span>
                <span class="subtitle-letter">&nbsp;</span>
                <span class="subtitle-letter">A</span>
                <span class="subtitle-letter">N</span>
                <span class="subtitle-letter">Y</span>
                <span class="subtitle-letter">W</span>
                <span class="subtitle-letter">H</span>
                <span class="subtitle-letter">E</span>
                <span class="subtitle-letter">R</span>
                <span class="subtitle-letter">E</span>
            </div>
        </div>
    </div>

    <div class="mt-10 text-slate-400 text-sm max-w-md text-center">
        <p>This is the high-resolution master for the DIGICAP logo.</p>
        <p class="mt-2">For Android App Icons: Use the SVG file provided.</p>
        <p class="mt-2">For Printing: Use the SVG file for vector-perfect quality.</p>
    </div>
</body>
</html>
