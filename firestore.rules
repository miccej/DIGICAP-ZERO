rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_ \\-\\.\\@]+$');
    }

    // --- LICENSE CODES ---
    // Only allow checking if a code exists. Users cannot list all codes.
    match /license_codes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId);
      allow create, list, update, delete: if false; 
    }

    // --- APPTEST IPS ---
    match /apptest_ips/{ipDocId} {
      allow read, write: if true;
    }

    // --- LEMON SQUEEZY LICENSES ---
    match /licenses/{email} {
      // Temporary loosening for testing: Allow any signed in user to check any license
      // This helps if email in token doesn't match license email exactly (case/anonymity)
      allow get: if isSignedIn();
      // Admin (you) can list all licenses
      allow list: if isSignedIn() && (request.auth.token.email == 'mikael.rj.johansson@gmail.com');
    }

    // --- WEBHOOK LOGS ---
    // These are only readable by the admin
    match /webhook_logs/{logId} {
      allow read: if isSignedIn() && (request.auth.token.email == 'mikael.rj.johansson@gmail.com');
    }

    // --- USER ACCESS ---
    // Users can read their own access state.
    // They can create it initially with 0 to 3 trials.
    // They can update it ONLY when redeeming a code or decrementing trials.
    match /user_access/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && isValidUserAccess(request.resource.data)
        && request.resource.data.trialRemaining >= 0
        && request.resource.data.trialRemaining <= 3
        && request.resource.data.isForever == false;

      // Updating access state
      allow update: if isSignedIn() 
        && request.auth.uid == userId
        && isValidUserAccess(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }

    // --- USER ACTIVITY ---
    match /user_activity/{activityId} {
      allow create: if isSignedIn() && isValidActivity(request.resource.data);
      allow read, update, delete: if false;
    }

    function isValidUserAccess(data) {
      return data.keys().hasAll(['isForever', 'trialRemaining', 'redeemedCodes', 'updatedAt'])
        && data.keys().size() == 4
        && data.isForever is bool
        && data.trialRemaining is int
        && data.redeemedCodes is list
        && data.updatedAt is timestamp;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['email', 'action', 'details', 'timestamp'])
        && data.keys().size() == 4
        && data.email is string
        && data.action is string
        && data.details is map
        && data.timestamp is string;
    }
  }
}
